# Obtain both values from Supabase: Project Settings > API.
# The publishable/anon key is intentionally public; NEVER expose a service_role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Required in production. Canonical HTTPS application origin used to build
# confirmation/recovery redirects; do not include a trailing path or slash.
APP_URL=http://localhost:3000
